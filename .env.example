# copy to .env.local and fill in real values — .env.local is gitignored

# Google Maps JavaScript API + Geocoding API key
VITE_GOOGLE_MAPS_API_KEY=

# Mapbox access token (pk.*) — used when the map provider is set to Mapbox
VITE_MAPBOX_TOKEN=

# external backend: ward/LGA/state boundaries, geocode fallback, verifications log
VITE_API_BASE=https://l8b0fu-nyfsf4ffa-arcadawebapps3.vercel.app

# local PostGIS-backed server (see server/.env.local) — settlement blocks + OSM buildings
VITE_LOCAL_API_BASE=http://localhost:8787
