# copy to .env.local and fill in real values — .env.local is gitignored

# local PostgreSQL connection (must have PostGIS 3.6+ enabled on PGDATABASE)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=groundtruth

# port this API server listens on
PORT=8787

# random secret used to sign admin login JWTs — generate your own, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# server-side Google Geocoding API key — used only as a last-resort fallback by POST /api/v1/verify-address when
# a descriptive address matches nothing in our own buildings/landmarks data. Deliberately separate from the
# frontend's VITE_GOOGLE_MAPS_API_KEY (that one is a browser key restricted by HTTP referrer). Leave unset to
# disable the fallback entirely — matching then only uses our own data.
GOOGLE_GEOCODING_API_KEY=
